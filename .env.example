# Default is the deterministic mock LLM -- no key needed, and it's what makes every
# scenario reproducible take after take. Only switch to a real model if you specifically
# want to demonstrate the OpenAI-compatible path; scenario behavior/failures are driven
# by ProductionConfig flags either way, not by which backend is generating the narrative.
LLM_PROVIDER=mock

# Only read when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
